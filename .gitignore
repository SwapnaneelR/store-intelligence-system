dataset/CCTV Footage*/
dataset/*.mp4

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.venv/
venv/
env/
.env.local
*.pptx

# ── Pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

