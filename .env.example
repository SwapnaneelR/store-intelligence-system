# ── API ──────────────────────────────────────────────────────────────────────
APP_NAME="Store Intelligence API"
APP_VERSION="1.0.0"
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/store_intelligence
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO
LOG_FORMAT=json

PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=500

DWELL_THRESHOLD_SECONDS=10
ANOMALY_LOITER_THRESHOLD_SECONDS=300
GROUP_PROXIMITY_PX=80
GROUP_TIME_WINDOW_SECONDS=3

# ── Frontend ─────────────────────────────────────────────────────────────────
# Build-time only — browser must reach this URL from host machine
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
